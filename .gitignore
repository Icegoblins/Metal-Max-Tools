# 仅 remote-data/ 与 .github/workflows/ 会提交到 GitHub（见 同步远程数据仓.py）
/*

!.gitignore
!remote-data/
!remote-data/**
!.github/
!.github/**

# 本地开发（即使目录被意外取消忽略也不提交）
.venv/
__pycache__/
*.pyc
mm2r-toolbox/node_modules/
mm2r-toolbox/src-tauri/target/
dist-shell/
release-assets/
.idea/
.vscode/
Thumbs.db
.DS_Store
.env
.env.*
*.pem
data-key.txt
~$*
