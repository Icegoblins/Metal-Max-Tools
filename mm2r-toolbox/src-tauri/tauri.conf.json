{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "METAL MAX 工具箱",
  "mainBinaryName": "METAL MAX 工具箱",
  "version": "1.0.0",
  "identifier": "com.mm2r.toolbox",
  "build": {
    "frontendDist": "../../dist-shell",
    "devUrl": "http://127.0.0.1:18765",
    "beforeBuildCommand": "npm run prepare:shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "METAL MAX 工具箱",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
